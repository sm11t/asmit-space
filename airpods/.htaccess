<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /airpods/

  # Serve existing files / directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /airpods or /airpods/ -> index.html
  RewriteRule ^/?$ /airpods/index.html [L]

  # Anything else under /airpods/ -> index.html (SPA fallback)
  RewriteRule . /airpods/index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed Next.js assets are immutable
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  # HTML must revalidate
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
