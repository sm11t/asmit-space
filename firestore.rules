rules_version = '2';

// ReadIt2Me rules. IMPORTANT: the nyclistings-6d00e project already has rules
// for `listings` (and possibly `pageviews` from the analytics branch) deployed
// via the console. When publishing, ADD the blocks below to the existing
// ruleset — do not replace it wholesale. (Do NOT `firebase deploy
// --only firestore:rules` until the console blocks are copied into this file,
// or the other apps' rules get wiped.)
//
// No wildcard match here on purpose: Firestore grants access if ANY match
// allows it, so a broad `{document=**}` rule would turn every validation
// below into dead code. Writes are limited to the known collections.
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Settings doc (voice, speed, queue, …) — small.
    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().size() <= 12;
    }

    // Book metadata.
    match /users/{uid}/books/{bookId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.keys().size() <= 12;
    }

    // Page transcripts (+ audio ref & timings written back by the client).
    match /users/{uid}/books/{bookId}/pages/{pageNo} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 15000;
    }

    // Playback position — the hottest write path, strictly validated.
    match /users/{uid}/progress/{bookId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.pageNo is int
        && request.resource.data.pageNo >= 1
        && request.resource.data.offsetSec is number
        && request.resource.data.offsetSec >= 0
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 40;
    }

    // TTS quota counters: written ONLY by the Cloud Function (admin SDK).
    match /usage/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
